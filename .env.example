# ============================================================
# Epaper-Notifications – Konfiguration
# Kopieren nach .env und anpassen:  cp .env.example .env
# Echte Umgebungsvariablen haben Vorrang vor Werten in dieser Datei.
# ============================================================

# --- Docker -----------------------------------------------------------
# Name des bestehenden Docker-Netzwerks, in dem Epaper-Notifications laufen soll
# (anlegen, falls es noch nicht existiert: make network)
DOCKER_NETWORK=platform

# --- Ports --------------------------------------------------------------
# Interner API-Port: nur für andere Services, PSK-geschützt.
API_PORT=8080
# Public-Port: liefert ausschließlich /confirm/{token}. Nur dieser Port
# wird vom Reverse Proxy nach außen weitergeleitet.
PUBLIC_PORT=8081
# Von außen erreichbare Basis-URL des Public-Ports (für Bestätigungs-Links in Mails).
PUBLIC_BASE_URL=https://doorsign.invalidtech.de

# --- Authentifizierung -------------------------------------------------
# Pre-Shared-Keys im Format name:secret, kommagetrennt. Der Name erscheint in den Logs,
# das Secret nie. Mindestlänge 16 Zeichen, pro Service ein eigenes Secret.
# Secret erzeugen:  openssl rand -hex 32
# Aufrufer senden:  Authorization: Bearer <secret>
API_PSKS=orders:CHANGE-ME-generate-with-openssl-rand-hex-32

# --- Logging ------------------------------------------------------------
LOG_LEVEL=info          # debug | info | warn | error
LOG_FORMAT=json         # json | text

# --- Pfade (im Container relativ zu /app) -------------------------------
TEMPLATES_DIR=./templates
CHANNELS_DIR=./config/channels

# --- Versand / Queue ----------------------------------------------------
WORKER_COUNT=4
QUEUE_SIZE=1000
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY=5s     # Exponential Backoff: 5s, 10s, 20s, ...
RETRY_MAX_DELAY=10m     # Obergrenze für die Wartezeit
MAX_BODY_BYTES=1048576  # maximale Größe eines API-Requests

# --- Bestätigung ----------------------------------------------------------
CONFIRM_TOKEN_TTL=24h

# --- Betrieb --------------------------------------------------------------
SHUTDOWN_TIMEOUT=30s

# --- Channel: E-Mail (wird in config/channels/email.yaml referenziert) ------
# Standardwerte passen zu Mailpit aus dem docker-compose (Profil "dev").
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=none           # starttls | tls | none
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="DoorSign <noreply@example.com>"
